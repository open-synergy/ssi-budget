<odoo>
  <record id="financial_budget_budget_view_search" model="ir.ui.view">
    <field name="name">financial_budget.budget - search</field>
    <field name="model">financial_budget.budget</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="type_id" />
                <field name="period_id" />
                <field name="parent_id" />
            </xpath>
            <xpath expr="//group[@name='group_by']" position="before">
                <filter
                        name="filter_yearly"
                        string="Yearly"
                        domain="[('periodicity', '=', 'yearly')]"
                    />
                <filter
                        name="filter_monthly"
                        string="Monthly"
                        domain="[('periodicity', '=', 'monthly')]"
                    />
            </xpath>
            <xpath expr="//group[@name='group_by']" position="inside">
                <filter
                        name="grp_type"
                        string="Type"
                        context="{'group_by':'type_id'}"
                    />
                <filter
                        name="grp_period"
                        string="Period"
                        context="{'group_by':'period_id'}"
                    />
                <filter
                        name="grp_periodicity"
                        string="Periodicity"
                        context="{'group_by':'periodicity'}"
                    />
                <filter
                        name="grp_parent"
                        string="Parent Budget"
                        context="{'group_by':'parent_id'}"
                    />
                <filter
                        name="grp_date_start"
                        string="Start Date"
                        context="{'group_by':'date_start'}"
                    />
            </xpath>
        </data>
    </field>
</record>

<record id="financial_budget_budget_view_tree" model="ir.ui.view">
    <field name="name">financial_budget.budget -tree</field>
    <field name="model">financial_budget.budget</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="type_id" />
                <field name="company_currency_id" invisible="1" />
                <field name="periodicity" />
                <field name="parent_id" optional="show" />
                <field name="period_id" />
                <field name="date_start" optional="hide" />
                <field name="date_end" optional="hide" />
            </xpath>
        </data>
    </field>
</record>

<record id="financial_budget_budget_view_form" model="ir.ui.view">
    <field name="name">financial_budget.budget - form</field>
    <field name="model">financial_budget.budget</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="company_currency_id" />
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                        name="action_create_monthly_budgets"
                        type="object"
                        string="Create Monthly Budgets"
                        attrs="{'invisible': ['|', ('periodicity', '!=', 'yearly'), ('state', '!=', 'open')]}"
                    />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="type_id" />
                <field name="periodicity" />
                <field name="allowed_period_ids" invisible="1" />
                <field name="period_id" domain="[('id', 'in', allowed_period_ids)]" />
                <field
                        name="parent_id"
                        attrs="{'invisible': [('periodicity', '!=', 'monthly')]}"
                        domain="[('periodicity', '=', 'yearly'), ('state', '=', 'open'), ('type_id', '=', type_id), ('company_id', '=', company_id), ('date_start', '&lt;=', date_start), ('date_end', '&gt;=', date_end)]"
                    />
                <field name="date_start" />
                <field name="date_end" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="detail" string="Budget Details">
                    <group name="detail" colspan="4" col="2">
                        <field
                                name="detail_ids"
                                colspan="2"
                                nolabel="1"
                                context="{'default_type_id': type_id}"
                            >
                            <tree>
                                <field name="company_currency_id" invisible="1" />
                                <field name="allowed_account_ids" invisible="1" />
                                <field
                                        name="account_id"
                                        domain="[('id', 'in', allowed_account_ids)]"
                                    />
                                <field name="direction" />
                                <field name="amount" />
                                <field
                                        name="amount_allocated"
                                        attrs="{'column_invisible': [('parent.periodicity', '!=', 'yearly')]}"
                                    />
                                <field
                                        name="amount_unallocated"
                                        attrs="{'column_invisible': [('parent.periodicity', '!=', 'yearly')]}"
                                    />
                            </tree>
                            <form>
                                <group name="detail_form" colspan="4" col="2">
                                    <field name="type_id" invisible="1" />
                                    <field name="company_currency_id" invisible="1" />
                                    <field name="allowed_account_ids" invisible="1" />
                                    <field
                                            name="account_id"
                                            domain="[('id', 'in', allowed_account_ids)]"
                                        />
                                    <field name="direction" />
                                    <field name="amount" />
                                </group>
                            </form>
                        </field>
                    </group>
                    <group name="detail_1" colspan="4" col="2" string="Summary">
                        <field name="detail_summary_ids" colspan="2" nolabel="1">
                            <tree>
                                <field name="account_id" />
                                <field name="amount" />
                            </tree>
                            <form>
                                <group name="detail_summary_form" colspan="4" col="2">
                                    <field name="account_id" />
                                    <field name="amount" />
                                </group>
                            </form>
                        </field>
                    </group>
                    <group name="detail_3" colspan="4" col="2">
                        <group name="detail_3_revenue" colspan="1" col="2">
                            <field name="amount_planned_revenue" />
                            <field name="amount_realized_revenue" />
                            <field name="amount_diff_revenue" />
                        </group>
                        <group name="detail_3_cost" colspan="1" col="2">
                            <field name="amount_planned_cost" />
                            <field name="amount_realized_cost" />
                            <field name="amount_diff_cost" />
                        </group>
                        <group name="detail_3_net" colspan="1" col="2">
                            <field name="amount_planned" />
                            <field name="amount_realized" />
                            <field name="amount_diff" />
                        </group>
                    </group>
                </page>
                <page
                        name="monthly_budget"
                        string="Monthly Budgets"
                        attrs="{'invisible': [('periodicity', '!=', 'yearly')]}"
                    >
                    <field name="child_ids">
                        <tree>
                            <field name="name" />
                            <field name="period_id" />
                            <field name="state" />
                        </tree>
                        <form>
                            <group name="monthly_budget_form" colspan="4" col="2">
                                <field name="name" />
                                <field name="period_id" />
                                <field name="state" />
                            </group>
                        </form>
                    </field>
                </page>
                <page name="account" string="Accounts">
                    <field name="detail_account_ids">
                        <tree>
                            <field name="account_id" />
                        </tree>
                        <form>
                            <group name="account_form" colspan="4" col="2">
                                <field name="account_id" />
                            </group>
                        </form>
                    </field>
                </page>
                <page name="move_line" string="Realization">
                    <group name="move_line_1" colspan="4" col="2" string="Items">
                        <field name="move_line_ids" nolabel="1">
                            <tree>
                                <field name="move_id" />
                                <field name="account_id" />
                                <field name="journal_id" />
                                <field name="amount" />
                            </tree>
                            <form>
                                <group name="move_line_form" colspan="4" col="2">
                                    <group name="move_line_form_1" colspan="1" col="2">
                                        <field name="move_id" />
                                        <field name="account_id" />
                                    </group>
                                    <group name="move_line_form_2" colspan="1" col="2">
                                        <field name="journal_id" />
                                        <field name="amount" />
                                    </group>
                                </group>
                            </form>
                        </field>
                    </group>
                    <group name="move_line_2" colspan="4" col="2" string="Summary">
                        <field name="move_line_summary_ids" nolabel="1">
                            <tree>
                                <field name="account_id" />
                                <field name="amount" />
                            </tree>
                            <form>
                                <group
                                        name="move_line_summary_form"
                                        colspan="4"
                                        col="2"
                                    >
                                    <field name="account_id" />
                                    <field name="amount" />
                                </group>
                            </form>
                        </field>
                    </group>
                </page>
                <page name="summary" string="Summary">
                    <group name="summary_1" colspan="4" col="2">
                        <field name="summary_ids" nolabel="1">
                            <tree>
                                <field name="currency_id" invisible="1" />
                                <field name="account_id" />
                                <field name="direction" />
                                <field name="amount_planned" />
                                <field name="amount_realized" />
                                <field name="amount_diff" />
                            </tree>
                            <form>
                                <group name="summary_form" colspan="4" col="2">
                                    <group name="summary_form_1" colspan="1" col="2">
                                        <field name="currency_id" invisible="1" />
                                        <field name="account_id" />
                                    </group>
                                    <group name="summary_form_2" colspan="1" col="2">
                                        <field name="amount_planned" />
                                        <field name="amount_realized" />
                                        <field name="amount_diff" />
                                    </group>
                                </group>
                            </form>
                        </field>
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="financial_budget_budget_view_hierarchy" model="ir.ui.view">
    <field name="name">financial_budget.budget - hierarchy</field>
    <field name="model">financial_budget.budget</field>
    <field name="arch" type="xml">
        <hierarchy
                string="Financial Budgets"
                parent_field="parent_id"
                child_field="child_ids"
            >
            <field name="name" />
            <field name="type_id" />
            <field name="period_id" />
            <field name="state" />
            <field name="amount_planned" />
            <field name="amount_realized" />
            <field name="amount_diff" />
        </hierarchy>
    </field>
</record>

<record id="financial_budget_budget_action" model="ir.actions.act_window">
    <field name="name">Financial Budgets</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">financial_budget.budget</field>
    <field name="view_mode">tree,form,hierarchy</field>
    <field name="search_view_id" ref="financial_budget_budget_view_search" />
</record>

<menuitem
        id="financial_budget_budget_menu"
        name="Financial Budgets"
        sequence="1"
        parent="ssi_cost_accounting.menu_root_budget"
        groups="ssi_financial_budget.financial_budget_budget_viewer_group"
        action="financial_budget_budget_action"
    />
</odoo>
