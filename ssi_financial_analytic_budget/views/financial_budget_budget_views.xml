<odoo>
<record id="financial_budget_budget_view_form" model="ir.ui.view">
    <field name="name">financial_budget.budget - form</field>
    <field name="model">financial_budget.budget</field>
    <field
            name="inherit_id"
            ref="ssi_financial_budget.financial_budget_budget_view_form"
        />
    <field name="mode">extension</field>
    <field name="arch" type="xml">
        <data>
            <xpath
                    expr="//field[@name='detail_ids']/tree/field[@name='amount']"
                    position="after"
                >
                <field name="amount_allocated_analytic" />
            </xpath>
        </data>
    </field>
</record>
</odoo>
